# ---------------------------------------------------------------------------
# PrintFlow environment configuration
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings > API). The anon/publishable key is safe
# to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the deployed app, used in auth email links (sign-up
# confirmation, password reset). Optional locally; set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets (never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Not used in Phase 1. Reserved for Phase 2 background jobs/webhooks that run
# without a signed-in user (e.g. scheduled marketplace order imports).
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 — marketplace integrations (not used yet)
# ETSY_API_KEY=
# ETSY_SHARED_SECRET=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=

# Phase 2 — shipping integrations (not used yet)
# ROYAL_MAIL_API_KEY=
# EVRI_API_KEY=
