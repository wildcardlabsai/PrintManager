# ---------------------------------------------------------------------------
# PrintFlow environment configuration
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings > API). The anon/publishable key is safe
# to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the deployed app, used in auth email links (sign-up
# confirmation, password reset). Optional locally; set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets (never prefix with NEXT_PUBLIC_, never commit real values)
# ---------------------------------------------------------------------------

# Required for integrations. Supabase → Project Settings → API → service_role.
# Used only on the server to read encrypted integration credentials and to run
# webhooks / scheduled syncs that have no signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts OAuth tokens and API keys before they are
# stored in the database. Generate with: openssl rand -base64 32
# Changing it later makes stored tokens unreadable (reconnect the integrations).
INTEGRATION_ENCRYPTION_KEY=

# Protects /api/cron/integrations (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Etsy (Open API v3) -----------------------------------------------------
# From https://www.etsy.com/developers/your-apps : keystring and shared secret.
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
# Must exactly match a callback URL registered on the Etsy app:
ETSY_REDIRECT_URI=https://your-domain.example/api/integrations/etsy/callback
# Webhook signing secret (whsec_...) from the Etsy developer portal, after you
# add the endpoint https://your-domain.example/api/webhooks/etsy
ETSY_WEBHOOK_SECRET=

# --- eBay (Sell APIs) --------------------------------------------------------
# production or sandbox
EBAY_ENVIRONMENT=production
# From https://developer.ebay.com/my/keys (App ID = client id, Cert ID = client secret)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay's redirect_uri is your RuName ("eBay Redirect URL name"), NOT a URL.
# In the RuName settings set both "auth accepted URL" and "auth declined URL" to
# https://your-domain.example/api/integrations/ebay/callback
EBAY_REDIRECT_URI=
# Marketplace Account Deletion notifications (required for production keysets).
# Token: 32–80 chars of your choosing; endpoint: the exact URL you register with eBay.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://your-domain.example/api/webhooks/ebay/account-deletion

# --- Shipping ---------------------------------------------------------------
# Royal Mail Click & Drop needs no environment variables: each business pastes
# its own Click & Drop API key in Settings → Integrations (stored encrypted).

# --- Printers (Phase 3) -------------------------------------------------------
# Printer Agents authenticate with their own rotating tokens (created in
# Printers → Printer Agents); no printer credentials are configured here.
# SUPABASE_SERVICE_ROLE_KEY and NEXT_PUBLIC_SITE_URL above are required.
# How often agents report in (seconds, default 10). Lower = snappier controls,
# more function invocations.
# PRINTER_AGENT_POLL_SECONDS=10

# --- Test only ---------------------------------------------------------------
# PRINTFLOW_TEST_API_OVERRIDES=1 lets tests/integration point the adapters at a
# local stub server. Never set this in production.
